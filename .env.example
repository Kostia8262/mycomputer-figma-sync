# Скопировать в .env на каждой машине — значения свои, в git не попадают.

# Путь к клону продакшена my_computer_new.
#   mac:     /Users/kostiantyn/Projects/my-computer-new
#   windows: D:\Проекты\my_computer_new
MC_REPO_PATH=

# Путь к репозиторию памяти claude-memory (для ежедневной синхронизации машин).
#   mac:     /Users/kostiantyn/claude-memory
#   windows: C:\Users\MrCOMP\claude-memory
MC_MEMORY_PATH=
