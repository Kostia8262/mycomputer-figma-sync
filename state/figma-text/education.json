    {
     "name": "Benefits",
     "id": "103:154",
     "lines": [
      {
       "t": "Чому My Computer Academy",
       "id": "I103:154;73:477;37:26;23:3"
      },
      {
       "t": "Все, що потрібно для старту у програмуванні та IT",
       "id": "I103:154;73:477;37:29"
      },
      {
       "t": "Ми не просто вчимо синтаксису — ми виховуємо практиків, що вирішують реальні задачі за допомогою коду.",
       "id": "I103:154;73:477;37:31"
      },
      {
       "t": "НАША ПЕРЕВАГА",
       "id": "I103:154;73:486;72:633"
      },
      {
       "t": "Малі групи",
       "id": "I103:154;73:507;455:7604"
      },
      {
       "t": "Реальні проєкти",
       "id": "I103:154;73:513;72:606"
      },
      {
       "t": "По 5–6 дітей у групі, щоб уваги вистачило кожній дитині.",
       "id": "I103:154;73:507;455:7606"
      },
      {
       "t": "Учні створюють ігри, сайти та додатки — справжні продукти, а не вправи.",
       "id": "I103:154;73:513;72:608"
      },
      {
       "t": "Індивідуальний темп",
       "id": "I103:154;73:486;72:642"
      },
      {
       "t": "Кожна дитина навчається у своєму ритмі. Ніякого тиску — тільки інтерес і прогрес.",
       "id": "I103:154;73:486;72:644"
      },
      {
       "t": "Онлайн навчання",
       "id": "I103:154;73:519;72:606"
      },
      {
       "t": "Сертифікат",
       "id": "I103:154;73:525;72:606"
      },
      {
       "t": "Підтримка 24/7",
       "id": "I103:154;73:531;72:606"
      },
      {
       "t": "Займайся з будь-якої точки світу через Zoom або Google Meet — без прив'язки до місця.",
       "id": "I103:154;73:519;72:608"
      },
      {
       "t": "Офіційний сертифікат про закінчення курсу. Разом із портфоліо стане вагомим аргументом у школах, ліцеях та університетах",
       "id": "I103:154;73:525;72:608"
      },
      {
       "t": "Чат з викладачем, допомога із завданнями та розбір помилок у будь-який час.",
       "id": "I103:154;73:531;72:608"
      }
     ]
    },
