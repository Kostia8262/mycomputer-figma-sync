     "name": "How It Works",
     "id": "103:497",
     "lines": [
      {
       "t": "Процес",
       "id": "I103:497;77:948;37:26;23:3"
      },
      {
       "t": "Як записатися на курс програмування",
       "id": "I103:497;77:948;37:29"
      },
      {
       "t": "Всього 4 кроки від заявки до першого проекту.",
       "id": "I103:497;77:948;37:31"
      },
      {
       "t": "01",
