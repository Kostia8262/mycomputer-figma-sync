    {
     "name": "Benefits",
     "id": "56:3103",
     "lines": [
      {
       "t": "Чому My Computer Academy",
       "id": "I56:3103;32:196;26:5;20:9"
      },
      {
       "t": "Все, що потрібно для старту в дизайні",
       "id": "I56:3103;32:196;26:7"
      },
      {
       "t": "Ми не просто вчимо інструментів — ми виховуємо практиків, які втілюють ідеї в реальні візуальні проєкти.",
       "id": "I56:3103;32:196;26:8"
      },
      {
       "t": "Наша перевага",
       "id": "I56:3103;32:204;26:30;20:23"
      },
      {
       "t": "Досвідчені викладачі",
       "id": "I56:3103;32:214;26:19"
      },
      {
       "t": "Реальні проєкти",
       "id": "I56:3103;32:220;26:19"
      },
      {
       "t": "Практикуючі дизайнери, закохані у свою справу та вміють пояснити складне просто.",
       "id": "I56:3103;32:214;26:21"
      },
      {
       "t": "Учні створюють ілюстрації, логотипи та інтерфейси — справжні роботи для портфоліо, а не вправи.",
       "id": "I56:3103;32:220;26:21"
      },
      {
       "t": "Індивідуальний темп",
       "id": "I56:3103;32:204;26:35"
      },
      {
       "t": "Кожна дитина навчається у своєму ритмі. Ніякого тиску — тільки інтерес і прогрес.",
       "id": "I56:3103;32:204;26:37"
      },
      {
       "t": "Онлайн навчання",
       "id": "I56:3103;32:227;26:19"
      },
      {
       "t": "Сертифікат",
       "id": "I56:3103;32:233;26:19"
      },
      {
       "t": "Підтримка 24/7",
       "id": "I56:3103;32:239;26:19"
      },
      {
       "t": "Займайся з будь-якої точки світу через Zoom або Google Meet — без прив'язки до місця.",
       "id": "I56:3103;32:227;26:21"
      },
      {
       "t": "Офіційний сертифікат про закінчення курсу — перший крок до портфоліо.",
       "id": "I56:3103;32:233;26:21"
      },
      {
       "t": "Чат з викладачем, допомога із завданнями та розбір помилок у будь-який час.",
       "id": "I56:3103;32:239;26:21"
      }
     ]
    },
