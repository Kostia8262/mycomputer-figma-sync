    {
     "name": "How It Works",
     "id": "56:3505",
     "lines": [
      {
       "t": "Процес",
       "id": "I56:3505;35:422;26:5;20:9"
      },
      {
       "t": "Як записатися на курс дизайну",
       "id": "I56:3505;35:422;26:7"
      },
      {
       "t": "Всього 4 кроки від заявки до першого проєкту.",
       "id": "I56:3505;35:422;26:8"
      },
      {
       "t": "01",
       "id": "I56:3505;35:429;28:83"
      },
      {
       "t": "02",
       "id": "I56:3505;35:441;28:83"
      },
      {
       "t": "03",
       "id": "I56:3505;35:453;28:83"
      },
      {
       "t": "04",
       "id": "I56:3505;35:465;28:83"
      },
      {
       "t": "Залиш заявку",
       "id": "I56:3505;35:429;28:87"
      },
      {
       "t": "Безкоштовний пробний урок",
       "id": "I56:3505;35:441;28:87"
      },
      {
       "t": "Старт навчання",
       "id": "I56:3505;35:453;28:87"
      },
      {
       "t": "Створюєш проєкт",
       "id": "I56:3505;35:465;28:87"
      },
      {
       "t": "Заповни форму нижче — ми передзвонимо протягом 30 хвилин і підберемо відповідний курс.",
       "id": "I56:3505;35:429;28:88"
      },
      {
       "t": "Оплачуєш курс, отримуєш доступ до матеріалів і розкладу. Заняття 1–2 рази на тиждень по 90 хвилин.",
       "id": "I56:3505;35:453;28:88"
      },
      {
       "t": "Наприкінці курсу дитина представляє власний проєкт і отримує сертифікат.",
       "id": "I56:3505;35:465;28:88"
      },
      {
       "t": "Дитина спробує заняття без зобов'язань. Побачиш формат, познайомишся з викладачем.",
       "id": "I56:3505;35:441;28:88"
      }
     ]
    },
